{
  "name": "@ddd-tool/domain-designer-cli",
  "version": "0.3.3",
  "private": false,
  "description": "",
  "type": "module",
  "bin": {
    "domain-designer-cli": "./bin/domain-designer-cli.cjs"
  },
  "files": [
    "./bin",
    "./packages/core/dist",
    "./packages/playground",
    "./packages/ui-component/dist",
    "./scripts",
    "./templates",
    "./tsconfig.json",
    "./pnpm-workspace.yaml"
  ],
  "scripts": {
    "dev": "pnpm -F playground dev",
    "dev:ui": "pnpm -F @ddd-tool/domain-designer-ui-component dev",
    "dev:page": "pnpm -F github-pages dev",
    "build": "pnpm syncver && pnpm fmt && pnpm -r build",
    "fmt": "pnpm exec prettier --write \"**/*.{vue,ts,mjs}\"",
    "test": "pnpm -r test",
    "test:cli": "pnpm -F cli test",
    "verify": "pnpm -r verify",
    "syncver": "zx ./scripts/sync-version.mjs",
    "demo:run": "node ./bin/domain-designer-cli.cjs run --source=./demo --debug",
    "demo:init": "node ./bin/domain-designer-cli.cjs init --source=./demo --debug",
    "demo:runWeb": "node ./bin/domain-designer-cli.cjs runWeb --source=./demo --debug",
    "demo:update": "node ./bin/domain-designer-cli.cjs update --source=./demo --debug",
    "demo:info": "node ./bin/domain-designer-cli.cjs info --debug",
    "demo:genCode": "node ./bin/domain-designer-cli.cjs genCode --source=./demo --debug"
  },
  "keywords": [
    "domain-designer",
    "ddd"
  ],
  "author": {
    "name": "AlphaFoxz@github.com",
    "email": "841958335@qq.com"
  },
  "repository": "https://github.com/ddd-tool/domain-designer-cli-node",
  "license": "Apache-2.0",
  "devDependencies": {
    "@primeuix/themes": "^2.0.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/bun": "^1.3.14",
    "@types/node": "~24.10.15",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/reactivity": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.6",
    "zx": "^8.8.5"
  },
  "dependencies": {
    "vue-fn": "0.4.1-rc"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
