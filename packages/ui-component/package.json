{
  "name": "@ddd-tool/domain-designer-ui-component",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "main": "./lib/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p build:lib && run-p verify && run-p build:sync-file",
    "build:lib": "vite build",
    "build:sync-file": "node ./scripts/build-sync-file.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://127.0.0.1:4173 'cypress open --e2e'",
    "verify": "vue-tsc -p ./tsconfig.app.json --composite false"
  },
  "dependencies": {
    "@ddd-tool/domain-designer-core": "workspace:^",
    "@primeuix/themes": "^2.0.3",
    "graphre": "^0.1.3",
    "nomnoml": "^1.7.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "cypress": "^16.2.0",
    "jsdom": "^30.1.3",
    "read-pkg": "^10.1.0",
    "start-server-and-test": "^3.0.13",
    "typescript": "npm:typescript-native-bridge@latest",
    "vite-plugin-top-level-await": "^1.6.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.27"
  }
}
